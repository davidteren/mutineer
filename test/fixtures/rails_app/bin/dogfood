#!/usr/bin/env bash
# Dogfood Mutineer against the bundled minimal Rails app. Asserts the three
# contracts the gem's own (Rails-free) suite cannot: that --rails boots a real
# config/environment + Zeitwerk + ActiveRecord with transactional fixtures, and
# that the strong/weak/baseline gates return the documented exit codes.
#
# Run from anywhere; it cd's to the app. Requires `bundle install` to have run in
# this directory first (the CI job and the README do that).
set -euo pipefail

cd "$(dirname "$0")/.."
export RAILS_ENV=test

SRC=app/models/order.rb
STRONG=test/models/order_test.rb
WEAK=test/models/order_weak_test.rb
BASELINE="$(mktemp)"

# Rails parallelize names a worker database test.sqlite3-<n> or _<n>. SQLite's
# own -wal and -shm files do not start with a digit, so they do not match.
shopt -s nullglob
rails_worker_dbs() { found=(storage/test.sqlite3[-_][0-9]*); }
# A direct run of this app's own suite leaves them behind. Start clean.
rails_worker_dbs
(( ${#found[@]} )) && rm -f "${found[@]}"

expect_exit() { # expect_exit <wanted> <label> -- <command...>
  local want=$1 label=$2; shift 3
  local code=0
  "$@" >/tmp/dogfood.out 2>&1 || code=$?
  if [ "$code" -ne "$want" ]; then
    echo "FAIL: $label — expected exit $want, got $code"
    cat /tmp/dogfood.out
    exit 1
  fi
  echo "ok: $label (exit $code)"
}

echo "== strong suite kills every mutant (exit 0) =="
expect_exit 0 "strong --rails --threshold 100" -- \
  bundle exec mutineer run "$SRC" --test "$STRONG" --rails --threshold 100

echo "== weak suite leaves survivors, threshold gate fails (exit 1) =="
expect_exit 1 "weak --rails --threshold 90" -- \
  bundle exec mutineer run "$SRC" --test "$WEAK" --rails --threshold 90

echo "== record a baseline from the strong suite =="
bundle exec mutineer run "$SRC" --test "$STRONG" --rails --format json --output "$BASELINE"

echo "== weak suite regresses against the strong baseline (exit 1) =="
expect_exit 1 "weak --baseline (strong)" -- \
  bundle exec mutineer run "$SRC" --test "$WEAK" --rails --baseline "$BASELINE"

echo "== strong suite does NOT regress against its own baseline (exit 0) =="
expect_exit 0 "strong --baseline (strong)" -- \
  bundle exec mutineer run "$SRC" --test "$STRONG" --rails --baseline "$BASELINE"

echo "== a line that ran at boot is ran_at_load, not a false survivor (#187) =="
REPORT="$(mktemp)"
expect_exit 0 "price_list --rails --threshold 100" -- \
  bundle exec mutineer run app/models/price_list.rb --test test/models/price_list_test.rb \
  --rails --threshold 100 --format json --output "$REPORT"
ruby -rjson -e 's = JSON.parse(File.read(ARGV[0]))["summary"]
  abort "FAIL: expected 1 ran_at_load, got #{s.inspect}" unless s.values_at("ran_at_load", "killed", "survived", "no_coverage") == [1, 1, 0, 0]' "$REPORT"
echo "ok: price_list mutant is ran_at_load"

echo "== a model in a namespace directory scores under --strategy reload (#253) =="
REPORT="$(mktemp)"
expect_exit 0 "billing/fee --rails --strategy reload --threshold 100" -- \
  bundle exec mutineer run app/models/billing/fee.rb --test test/models/billing/fee_test.rb \
  --rails --strategy reload --threshold 100 --format json --output "$REPORT"
ruby -rjson -e 's = JSON.parse(File.read(ARGV[0]))["summary"]
  abort "FAIL: expected every billing/fee mutant killed, got #{s.inspect}" unless s["killed"] > 1 && s.values_at("survived", "errored", "no_coverage") == [0, 0, 0]' "$REPORT"
echo "ok: billing/fee mutants are killed"

echo "== a class body with enum, skip_callback, and a lazy concern reloads (#378, #383, #384) =="
REPORT="$(mktemp)"
expect_exit 0 "shipment + trackable --rails --no-daemon --strategy reload --threshold 100" -- \
  bundle exec mutineer run app/models/shipment.rb app/models/concerns/trackable.rb \
  --rails --no-daemon --strategy reload --threshold 100 --format json --output "$REPORT"
ruby -rjson -e 's = JSON.parse(File.read(ARGV[0]))["summary"]
  abort "FAIL: expected every shipment and trackable mutant killed, got #{s.inspect}" unless s["killed"] > 1 && s.values_at("survived", "errored", "no_coverage") == [0, 0, 0]' "$REPORT"
echo "ok: shipment and trackable mutants are killed"

echo "== a weak test lets every shipment and trackable mutant survive under reload (#378, #383, #384) =="
REPORT="$(mktemp)"
expect_exit 0 "shipment + trackable weak --rails --no-daemon --strategy reload" -- \
  bundle exec mutineer run app/models/shipment.rb app/models/concerns/trackable.rb \
  --test test/models/shipment_weak_test.rb \
  --rails --no-daemon --strategy reload --format json --output "$REPORT"
ruby -rjson -e 's = JSON.parse(File.read(ARGV[0]))["summary"]
  abort "FAIL: expected every shipment and trackable mutant to run and survive, got #{s.inspect}" unless s["survived"] > 1 && s["survived"] == s["total"]' "$REPORT"
echo "ok: shipment and trackable mutants survive a weak test"

echo "== reload runs each validator and block callback once, like redefine (#390) =="
for strategy in reload redefine; do
  REPORT="$(mktemp)"
  expect_exit 0 "parcel --rails --no-daemon --strategy $strategy" -- \
    bundle exec mutineer run app/models/parcel.rb --test test/models/parcel_test.rb \
    --rails --no-daemon --strategy "$strategy" --format json --output "$REPORT"
  ruby -rjson -e 's = JSON.parse(File.read(ARGV[0]))["summary"]
    abort "FAIL: expected every mutant to run and survive under #{ARGV[1]}, got #{s.inspect}" unless s["survived"] > 0 && s["survived"] == s["total"]' "$REPORT" "$strategy"
done
echo "ok: parcel mutants survive under reload and redefine"

echo "== a parent reload does not restore a skipped callback (#414) =="
# Eager load reaches the subclasses before the parent file reloads, as a
# production boot does. heavy? is weak, so it survives. require_weight is
# killed. A restored skip would kill every mutant, or the modes would disagree.
POSTAGE_RELOAD="$(mktemp)"
POSTAGE_REDEFINE="$(mktemp)"
POSTAGE_DAEMON="$(mktemp)"
expect_exit 0 "postage reload" -- \
  env MUTINEER_EAGER_LOAD=1 bundle exec mutineer run app/models/postage.rb \
  --test test/models/postage_test.rb --rails --no-daemon --strategy reload \
  --format json --output "$POSTAGE_RELOAD"
expect_exit 0 "postage redefine" -- \
  env MUTINEER_EAGER_LOAD=1 bundle exec mutineer run app/models/postage.rb \
  --test test/models/postage_test.rb --rails --no-daemon --strategy redefine \
  --format json --output "$POSTAGE_REDEFINE"
expect_exit 0 "postage daemon" -- \
  env MUTINEER_EAGER_LOAD=1 bundle exec mutineer run app/models/postage.rb \
  --test test/models/postage_test.rb --rails --daemon \
  --format json --output "$POSTAGE_DAEMON"
ruby -rjson -e 'rows = ARGV.map { |p| JSON.parse(File.read(p))["summary"].values_at("killed", "survived", "errored") }
  abort "FAIL: postage #{rows.inspect}" unless rows.uniq.size == 1 && rows[0][0] > 0 && rows[0][1] > 0 && rows[0][2] == 0
  puts "ok: postage reload, redefine and daemon agree (#{rows[0].join(" ")})"' \
  "$POSTAGE_RELOAD" "$POSTAGE_REDEFINE" "$POSTAGE_DAEMON"

echo "== Rails parallelize creates no worker database =="
rails_worker_dbs
if (( ${#found[@]} )); then
  echo "FAIL: Rails parallelize created a worker database: ${found[*]}"
  exit 1
fi
echo "ok: no Rails parallelize worker database"

echo "All Rails dogfood checks passed."
